# Monad Escrow - Environment Configuration Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ===== RPC ENDPOINTS =====
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz/
MONAD_MAINNET_RPC=https://mainnet-rpc.monad.xyz/
SEPOLIA_RPC=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# ===== ACCOUNT CREDENTIALS =====
# Your private key (64 hex characters, WITHOUT 0x prefix)
# WARNING: Never share or commit this!
# Get from: MetaMask -> Account Details -> Export Private Key
PRIVATE_KEY=your_64_character_hex_string_here

# ===== DEPLOYED CONTRACTS =====
# After deploying to Monad testnet, save the factory address here
ESCROW_FACTORY_ADDRESS=0x...

# ===== OPTIONAL: VERIFICATION =====
# For Etherscan-like verification (if needed)
ETHERSCAN_API_KEY=your_api_key_here

# ===== OPTIONAL: INFURA/ALCHEMY =====
# If using Infura/Alchemy instead of default RPC
INFURA_PROJECT_ID=your_infura_id_here
ALCHEMY_API_KEY=your_alchemy_key_here

# ===== NETWORK CONFIGURATION =====
# Chain ID for Monad testnet (do not change)
CHAIN_ID=10143

# Gas price in gwei (52 gwei for Monad testnet)
GAS_PRICE=52000000000

# ===== OPTIONAL: LOGGING =====
# Set to "true" for verbose logging
DEBUG=false

# ===== OPTIONAL: INTEGRATION =====
# For OpenClaw skill integration
OPENCLAW_SKILL_ID=your_skill_id
OPENCLAW_API_KEY=your_api_key
